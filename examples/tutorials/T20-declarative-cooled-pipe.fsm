fieldsmith 1
# === FIELDSMITH LITERATE CASE ===
# @id: T20
# @code: T20
# @category: tutorial
# @level: Advanced
# @title: Declarative 1D Coolant Channel + 3D Staggered Thermo-Elastic Adjoint Co-Design
# @subtitle: Author a composable 1D thermal-hydraulic `system` block directly inside `.fsm`, project station-resolved `lerp(z, ...)` film and pressure profiles onto a 3D SS316L cooling liner, verify engineering `assert` contracts, and differentiate 3D peak temperature and von Mises stress in O(1) staggered adjoint solves.
# @verification_badge: Verified by V63 · Dual-AD 1D System + 3D Staggered Thermo-Elastic Adjoints
# @doc_path: docs/tutorials/T20-declarative-cooled-pipe.md
# @fsm_path: examples/tutorials/T20-declarative-cooled-pipe.fsm
# @starter_fsm_name: t20-declarative-cooled-pipe.fsm
# @verification_refs: crates/fieldsmith-verify/tests/v63_architecture_lock.rs
# ---
# @mcp: Solve 1D coolant channel and sync 3D lerp BCs || solve_coupled_system || {"sync_cad":true}
# @mcp: Verify initial 3D thermo-elastic contracts || verify || {"h":4.5}
# @mcp: Compute 3D staggered thermo-elastic adjoints wrt mdot and wall_t || sensitivity || {"params":["mdot","wall_t"],"h":4.5}
# @mcp: Add temporary mass budget contract || upsert_assert || {"label":"Mass budget","metric":"mass_g","target":"<= 100","unit":"g"}
# @mcp: Re-verify contracts with mass budget || verify || {"h":4.5}
# @mcp: Remove temporary mass budget contract || delete_assert || {"label":"Mass budget"}
# @mcp: Co-optimise 1D coolant flow and 3D wall thickness for minimum mass || optimise || {"objective":"mass_g","params":["mdot","wall_t"],"max_iters":5,"h":4.5}
# @mcp: Re-verify contracts on optimised 1D+3D liner || verify || {"h":4.5}
# ---
# @assert: Peak 3D liner temperature bounded || max_temp || <= 95.0 || <= 95.0 || C
# @assert: Peak 3D thermo-elastic von Mises stress bounded || max_vm_elem || <= 220.0 || <= 220.0 || MPa
# @assert: Structural safety factor above 1.0 || min_safety_factor || >= 1.0 || >= 1.0 || -
# ---
# @step: 1. Inspect the 1D Declarative Coolant System in Systems (4) || systems
#   Open Systems (4) to inspect `coolant_liner_1d`: an axial 25-station plug-flow energy and pressure-drop balance compiled via forward-mode Dual-Number AD. Drag `mdot` or edit the `.fsm` `system` equations directly to project updated `lerp(z, ...)` Robin and pressure profiles onto the 3D bore wall (`⌀ 12 mm` ID).
# @expected:
#   Conservation audit closes within tolerance and `bore_conv` / `bore_press` receive station-resolved `lerp(z, ...)` fields.
# @step: 2. Run 3D Thermo-Elastic Solve, Contract Verification & Adjoint Sensitivities in Results (3) || results
#   Switch to Results (3). Standalone 3D solves, contract verifications, and sensitivity runs automatically solve the embedded `system` equilibrium first. Click **Verify Asserts** and **Compute ∂Φ/∂p** to inspect `∂T_max/∂p` and `∂σ_vM/∂p` across `mdot` and `wall_t` in O(1) staggered adjoint solves.
# @expected:
#   All 3 contracts pass and `∂T_max/∂mdot < 0` confirms higher coolant flow lowers peak 3D wall temperature.
# === END LITERATE HEADER ===

name "Declarative Cooled SS316L Liner"
material ss316l

let mdot = 0.012
let wall_t = 3

cylinder outer_pipe r=6 + wall_t h=60 at=(0, 0, 30)
cylinder inner_bore r=6 h=64 at=(0, 0, 30) subtract

region bore_wall = inner_bore.side
region outer_wall = outer_pipe.side
region pipe_base = outer_pipe.bottom

support base_fix pipe_base fixed=xyz
load bore_press bore_wall pressure=0.8 case="Operating"
convection bore_conv bore_wall h=0.025 tinf=25 case="Thermal"
heatflux outer_flux outer_wall q=0.12 case="Thermal"

system coolant_liner_1d title="1D Cooled SS316L Liner" sector="Thermal-Fluids" nodes=25 span=(0, 60) axis=z {
  design mdot nominal=0.012 min=0.004 max=0.060 unit="kg/s" symbol="m_dot" category=process
  design wall_t nominal=3 min=1.5 max=5.0 unit="mm" symbol="t_w" category=geometry
  epistemic h_mult nominal=1.0 sigma=0.08 min=0.75 max=1.25 unit="-" symbol="k_h"
  state T_f init="25" scale=50 unit="C" symbol="T_f"
  state P_f init="0.8" scale=1 unit="MPa" symbol="P_f"
  aux cp expr="4180"
  aux r_out expr="6 + wall_t"
  aux q_lin expr="2 * pi * r_out * 0.12 * (1 + 0.2 * sin(pi * s / 60))"
  aux h_film expr="h_mult * 0.025 * pow(mdot / 0.012, 0.8)"
  residual T_f eq="mdot * cp * d_ds(T_f) - q_lin" bc_left="T_f - 25"
  residual P_f eq="d_ds(P_f) + 0.0025 * pow(mdot / 0.012, 1.8)" bc_left="P_f - 0.8"
  objective exit_temp expr="T_f" reduce=exit kind=upper limit=65 unit="C" symbol="T_out"
  objective mdot_min expr="mdot" reduce=value kind=minimize unit="kg/s" symbol="m_dot"
  audit enthalpy inflow="mdot * cp * entry(T_f)" outflow="mdot * cp * exit(T_f)" source="integral(q_lin)" tol=0.02 unit="W"
  bind bore_conv attr=tinf expr="T_f"
  bind bore_conv attr=h expr="h_film"
  bind bore_press attr=pressure expr="P_f"
}

solve size=4.5 tref=20 build=(0, 0)

assert "Peak 3D liner temperature bounded" metric="max_temp" target="<= 95.0" tol="<= 95.0" unit="C"
assert "Peak 3D thermo-elastic von Mises stress bounded" metric="max_vm_elem" target="<= 220.0" tol="<= 220.0" unit="MPa"
assert "Structural safety factor above 1.0" metric="min_safety_factor" target=">= 1.0" tol=">= 1.0" unit="-"
